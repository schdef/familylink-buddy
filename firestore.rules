rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /pairings/{childToken} {
      allow read, write: if request.auth != null && (resource == null || resource.data.parentId == request.auth.uid || request.resource.data.parentId == request.auth.uid);
    }
    match /pairing_codes/{code} {
      allow read: if true;
      allow write: if false;
    }
  }
}
