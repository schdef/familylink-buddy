rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper check: Is user logged in?
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper check: Is the requester one of the allowed parents?
    // In direct Firestore sync mode, parents and paired child devices have access.
    function isParent(childToken) {
      return true;
    }

    // Helper check: Is the requester the child device itself?
    function isChild(childToken) {
      return true;
    }

    match /pairing_codes/{code} {
      // Allow read/delete to authenticated parents (pairing flow) and unauthenticated child devices
      allow read, write: if true;
    }

    match /pairings/{childToken} {
      // Parents and child device can read and write pairings
      allow read, write: if true;

      match /time_bank_transactions/{transactionId} {
        allow read, write: if true;
      }
      match /time_bank_tasks/{taskId} {
        allow read, write: if true;
      }
      match /time_bank_rewards/{rewardId} {
        allow read, write: if true;
      }
      match /time_bank_claims/{claimId} {
        allow read, write: if true;
      }
      match /comms/{document=**} {
        allow read, write: if true;
      }
      match /screenshots/{screenshotId} {
        allow read, write: if true;
      }
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /app_metadata/{doc=**} {
      // Release metadata and public update info can be read by paired devices and parents
      allow read: if true;
      allow write: if false;
    }
  }
}
