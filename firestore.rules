rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper check: Is user logged in?
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper check: Is the requester one of the allowed parents?
    function isParent(childToken) {
      return isSignedIn() && (
        resource == null || 
        resource.data.parentId == request.auth.uid || 
        (resource.data.allowedParentUids != null && request.auth.uid in resource.data.allowedParentUids)
      );
    }

    // Helper check: Is the requester the child device itself?
    function isChild(childToken) {
      return (isSignedIn() && request.auth.token.fcmToken == childToken) || !isSignedIn();
    }

    match /pairing_codes/{code} {
      // Allow read/delete to authenticated parents (pairing flow)
      allow read, delete: if isSignedIn();
      // Allow create/write to child device (unauthenticated)
      allow create, update: if true;
    }

    match /pairings/{childToken} {
      // Parents and child device can read
      allow read: if isParent(childToken) || isChild(childToken);
      // Parents create pairings
      allow create: if isSignedIn();
      // Parent can update volume commands and screentime; child can update volume report and time coins
      allow update: if isParent(childToken) || isChild(childToken);
      // Only parents can delete pairings
      allow delete: if isParent(childToken);

      match /time_bank_transactions/{transactionId} {
        allow read, write: if isParent(childToken) || isChild(childToken);
      }
      match /time_bank_tasks/{taskId} {
        allow read, write: if isParent(childToken) || isChild(childToken);
      }
      match /time_bank_rewards/{rewardId} {
        allow read, write: if isParent(childToken) || isChild(childToken);
      }
      match /time_bank_claims/{claimId} {
        allow read, write: if isParent(childToken) || isChild(childToken);
      }
      match /comms/{document=**} {
        allow read, write: if isParent(childToken) || isChild(childToken);
      }
      match /screenshots/{screenshotId} {
        allow read, write: if isParent(childToken) || isChild(childToken);
      }
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /app_metadata/{doc=**} {
      // Release metadata and public update info can be read by paired devices and parents
      allow read: if true;
      allow write: if false;
    }
  }
}
