<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glowing_overlay_bg"
    android:padding="8dp">

    <!-- Top drag visual indicator -->
    <View
        android:id="@+id/dragIndicator"
        android:layout_width="32dp"
        android:layout_height="3dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:background="@color/child_border" />

    <!-- Left section: Countdown display -->
    <LinearLayout
        android:id="@+id/countdownLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentLeft="true"
        android:layout_marginLeft="12dp"
        android:orientation="vertical"
        android:gravity="left|center_vertical">

        <TextView
            android:id="@+id/countdownText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="03:00"
            android:textColor="@color/child_red"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/countdownLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overlay_label"
            android:textColor="@color/child_muted"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textAllCaps="true" />
    </LinearLayout>

    <!-- Right section: Sizing preset switcher -->
    <TextView
        android:id="@+id/sizeToggleButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_centerVertical="true"
        android:layout_alignParentRight="true"
        android:layout_marginRight="8dp"
        android:background="@drawable/oval_button_bg"
        android:textColor="@color/child_text"
        android:text="+"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true" />

    <!-- Center section: Animation Container -->
    <FrameLayout
        android:id="@+id/animationContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toRightOf="@id/countdownLayout"
        android:layout_toLeftOf="@id/sizeToggleButton"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/earthImage"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_earth"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/launchpadImage"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal|bottom"
            android:src="@drawable/ic_launchpad"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/rocketImage"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_rocket"
            android:visibility="gone" />
    </FrameLayout>

</RelativeLayout>
